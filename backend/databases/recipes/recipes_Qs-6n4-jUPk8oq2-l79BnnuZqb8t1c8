{
  "name": "perfect pie crust",
  "id": "recipes_Qs-6n4-jUPk8oq2-l79BnnuZqb8t1c8",
  "category": "recipes",
  "author": "Amy Nash",
  "description": "A recipe for a flaky, tender, and easy-to-make pie crust using butter and shortening.",
  "source": "https://houseofnasheats.com/perfect-pie-crust/",
  "preparationTime": {
    "total": 45,
    "unit": "min"
  },
  "tags": [
    "pie",
