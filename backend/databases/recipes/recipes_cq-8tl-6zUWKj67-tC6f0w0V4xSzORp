  "method": [
    {
      "step": 1,
      "description": "Add flour and salt to a food processor and pulse a few times to combine."
    },
    {
      "step": 2,
      "description": "Add the cold butter pieces and pulse about 8-10 times, until the mixture resembles coarse meal with some pea-sized pieces of butter remaining."
    },
    {
      "step": 3,
      "description": "With the food processor running, gradually add the ice water through the feed tube just until the dough comes together in clumps (you may not need all of it). Be careful not to overmix."
    },
    {
      "step": 4,
      "description": "Turn the dough out onto a lightly floured surface. Divide in half and shape each half into a disc. Wrap each disc tightly in plastic wrap and refrigerate for at least 30 minutes (or up to 2 days) before rolling out."
    }
