  "method": [
    {
      "step": 1,
      "description": "In a bowl, mix the softened butter and sugar until you get a light, creamy consistency."
    },
    {
      "step": 2,
      "description": "Add the eggs one by one, whisking after each addition until combined."
    },
    {
      "step": 3,
      "description": "Sift the all-purpose flour together with baking powder and a pinch of salt into the bowl."
    },
    {
      "step": 4,
      "description": "Using a spatula, carefully fold the dry ingredients into the wet ingredients until a smooth batter forms."
    },
    {
      "step": 5,
      "description": "Grease a baking dish (fluted tart pan shown) with butter."
    },
    {
      "step": 6,
      "description": "Pour the batter into the prepared baking dish, spreading it evenly."
    },
    {
      "step": 7,
      "description": "Wash and dry the plums. Cut them in half and remove the pits."
    },
    {
      "step": 8,
      "description": "Arrange the plum halves cut-side down (skin-side up) on top of the batter. This method allows plums to release more juice into the cake, making it moist."
    },
    {
      "step": 9,
      "description": "Sprinkle the plums with lemon juice."
    },
    {
      "step": 10,
      "description": "Sprinkle the brown sugar over the plums."
    },
    {
      "step": 11,
      "description": "Generously sprinkle cinnamon over the top."
    },
    {
      "step": 12,
      "description": "Bake in a preheated oven.",
      "time": 50,
      "temperature": {
        "value": 180,
        "unit": "C"
      }
    },
    {
      "step": 13,
      "description": "Remove from the oven and let cool slightly before serving. The tart is best served warm."
    }
  ],
